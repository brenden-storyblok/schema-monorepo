{
  "name": "@monorepo/ui-core",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./schema": {
      "types": "./src/schema/schema.ts",
      "import": "./src/schema/schema.ts",
      "default": "./src/schema/schema.ts"
    }
  },
  "scripts": {
    "schema:validate": "storyblok schema validate src/schema/schema.ts"
  },
  "dependencies": {
    "@monorepo/storyblok-utils": "*",
    "@storyblok/react": "^7.3.1",
    "@storyblok/schema": "^0.5.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "nx": {
    "name": "ui-core",
    "targets": {
      "schema:push": {
        "cache": false
      }
    }
  }
}
